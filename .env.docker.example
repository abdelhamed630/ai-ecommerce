# Docker environment template
# Copy this file to .env.docker and replace every CHANGE_ME value.

SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ai_ecommerce
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_REDIS_PASSWORD

ALLOWED_HOSTS=localhost,127.0.0.1,api,shop.example.com
# Browser origins allowed by CORS (comma-separated, no '*', no trailing slash). It MUST contain
# the exact origin of your frontend (scheme + host + port), otherwise browsers block its requests.
# Empty = no cross-origin browser access. Example: https://shop.example.com
CORS_ALLOWED_ORIGINS=

# JWT lifetime in minutes (1-10080). 60 is the backend default; there is no refresh-token endpoint.
ACCESS_TOKEN_EXPIRE_MINUTES=60

NGINX_PORT=8080
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_API_DOCS=false
CELERY_BEAT_ENABLED=false

# Optional: shopping chatbot LLM. Empty key = assistant answers "temporarily unavailable".
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
