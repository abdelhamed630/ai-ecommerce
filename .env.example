# Local DEVELOPMENT settings. Copy to `.env` (which is git-ignored) and adjust.
# Never commit real secrets. Full reference: docs/production.md

ENVIRONMENT=development
DEBUG=true
APP_NAME=AI E-Commerce API

# SQLite for local development (default). PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_ecommerce
DATABASE_URL=sqlite:///./ecommerce.db

# Empty falls back to a dev-only key with a warning. Generate a real one with:
#   openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated. Development defaults are permissive.
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

LOG_LEVEL=INFO
LOG_FORMAT=text
CHURN_MODEL_PATH=ml/artifacts/churn/churn_model.joblib
