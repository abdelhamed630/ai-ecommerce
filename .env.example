# Local DEVELOPMENT settings. Copy to `.env` (which is git-ignored) and adjust.
# Never commit real secrets. Full reference: docs/production.md

ENVIRONMENT=development
DEBUG=true
APP_NAME=AI E-Commerce API

# PostgreSQL is the supported database. Replace USER / PASSWORD / DB with your own values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_ecommerce

# Empty falls back to a dev-only key with a warning. Generate a real one with:
#   openssl rand -hex 32
SECRET_KEY=6a3dac24a3dd1190c4d858f1041d3bf7f75bc90dc065ec88b7056e603c492bdf
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated. Development defaults are permissive.
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

LOG_LEVEL=INFO
LOG_FORMAT=text
CHURN_MODEL_PATH=ml/artifacts/churn/churn_model.joblib

# Shopping chatbot LLM (Groq, OpenAI-compatible API). Leave GROQ_API_KEY empty to disable the LLM:
# POST /chatbot/chat then answers "temporarily unavailable" (products still returned).
# Never commit a real key; .env is git-ignored.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15

# Chatbot protection / memory. Max chat requests per user per minute (0 = unlimited) and how
# many previous messages of the conversation are given to the LLM for follow-up questions.
CHATBOT_RATE_LIMIT_PER_MINUTE=20
CHATBOT_MAX_HISTORY_TURNS=6
